# Dependencies
**/node_modules/
**/vendor/

# Production builds
**/dist/
**/build/
**/dist-ssr/
**/*.local

# Environment files
**/.env
!**/.env.example

# IDE & OS files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/tasks.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
**/storage/logs/*.log

# Laravel Storage & Cache
**/storage/framework/cache/data/*
**/storage/framework/sessions/*
**/storage/framework/views/*
!**/storage/framework/cache/.gitignore
!**/storage/framework/sessions/.gitignore
!**/storage/framework/views/.gitignore
